# Overrides that must win over the board definition's own defaults
# (gen_bmgr_codes/board_manager.defaults). The board manager reports that its
# file has higher priority than the project sdkconfig.defaults, so this is the
# slot for a value the product has to change on top of the board.
#
# Every value here is checked in build/config/sdkconfig.h after a build —
# writing a line is not the same as it reaching the image.

# The framework's default event-loop task ("sys_evt") dispatches the Wi-Fi and IP
# events — including everything esp-netif and the Wi-Fi driver post from the
# esp_timer task during a station start, a deep path on this target. Its stock
# 2304-byte stack, and later 4096, overflowed on a configured boot; at 8192 that
# crash is gone. Keep the headroom: the alternative is a boot loop.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=8192

# The mDNS service task ("mdns") overflows its default 4096-byte stack 15-30 s
# into an idle session on this panel — a stack-guard hit during its periodic
# work, not while answering a query. mDNS is a convenience on this product (the
# settings page is reached by the panel's IP address, or through the onboarding
# SoftAP at http://192.168.4.1/ while unconfigured), so the task is given room
# rather than switched off: mdns has no on/off switch, and calling its init
# would still create the task.
CONFIG_MDNS_TASK_STACK_SIZE=8192

# The flash-write fix lives in sdkconfig.defaults (CONFIG_ESP_INT_WDT_TIMEOUT_MS).
# The task watchdog this file does NOT touch: with the interrupt watchdog at
# 1500 ms, the task watchdog's 10 s still prints first, so the log names the
# task that blocked instead of only the CPU that was reset.
