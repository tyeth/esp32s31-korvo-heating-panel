# ZeroCode AI - Common sdkconfig defaults
# Protocol-specific configs are added by templates via sdkconfig merge.

# eFuse virtualization — MANDATORY, do not remove. Compiles the eFuse-program path
# out of the app AND bootloader, so a generated image can never permanently burn a
# one-time eFuse (secure boot / flash encryption / download-mode / JTAG lockout).
# Platform-enforced: the agent write tool and every build refuse its removal.
CONFIG_EFUSE_VIRTUAL=y

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Flash size — the floor, matching the default 4mb partition table. A board with
# more flash overrides it (sdkconfig.defaults.board), and a bigger partition
# table block sets the matching size.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Compiler optimization for size
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_NEWLIB_NANO_FORMAT=y

# The RV32IMC core PAUSES all three timers during a flash write (the cache is
# halted, so its instructions are not fetched); with the stock 300 ms the INT_WDT
# trips, prints the 1.5 s-configured INT_WDT timeout warning and resets both CPUs
# ("PRO CPU has been reset by WDT"). The abort lands in the ROM — the MSPI
# "set to best phase" lines at the top of the log are the ROM's own PSRAM timing
# tune on the way back up, which is the boot noise worth reading rather than
# suppressing.
CONFIG_ESP_INT_WDT_TIMEOUT_MS=1500

# Diagnostics stay readable: the panel is being brought up in the field and a
# silent device cannot be debugged — but "readable" is not "everything".
# CONFIG_LOG_DEFAULT_LEVEL_VERBOSE used to be set here and filled the console
# with MIPI/LCD, ADC-oneshot, SPI-mem and Wi-Fi driver traffic. The build default
# is now INFO for every IDF tag, the panel's own tags are raised to DEBUG from
# log_level.cpp, and VERBOSE is one command away (`log * VERBOSE`, or the
# log-level drop-down on the settings page). The MAXIMUM stays at its default
# (above the default level), which is what lets esp_log_level_set() raise a tag
# at runtime at all.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# The MAXIMUM stays at VERBOSE: it is the highest level esp_log_level_set() may
# raise a tag to, and every tag raised at runtime depends on it (the panel's own
# tags at DEBUG, `log * VERBOSE`, the settings page's drop-down).
CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y

# Stack sizes
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# No build date/time in the app or bootloader descriptor. Source paths are
# hidden by the prefix maps in cmake/prefix_maps.cmake.
# CONFIG_APP_COMPILE_TIME_DATE is not set
# CONFIG_BOOTLOADER_COMPILE_TIME_DATE is not set

# Block, framework and product contributions
CONFIG_SR_MN_EN_MULTINET7_QUANT=y
CONFIG_SR_WN_WN9_HIESP=y
CONFIG_MODEL_IN_FLASH=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_FONT_MONTSERRAT_8=y
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_30=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_34=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_MONTSERRAT_38=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_MONTSERRAT_42=y
CONFIG_LV_FONT_MONTSERRAT_44=y
CONFIG_LV_FONT_MONTSERRAT_46=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_QRCODE=y
CONFIG_ESP_TASK_WDT_INIT=y
# Log, don't reboot: this is a VERBOSE diagnostic build, and a slow tag-level log
# line must not cost the panel its boot. Idle-task starvation still panics.
# CONFIG_ESP_TASK_WDT_PANIC is not set
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y

# The framework's default event-loop task ("sys_evt") dispatches the Wi-Fi/IP
# events. It overflowed its stack on this panel's configured boot — in the
# framework's own dispatch, not in anything of ours (app_mqtt's handler only
# copies the event into a queue). The value is set in sdkconfig.product, the slot
# that overrides the board definition's own defaults (the board manager reports
# its file has higher priority).

# The board definition (gen_bmgr_codes/board_manager.defaults) enables the DVP
# camera video device; esp_video also enables the USB-UVC video device on this
# target, and neither is used by this product. Turning both off keeps them out
# of the image so the 2.25 MB OTA slot fits (the scaffold overflowed it by
# ~360 KB before this).
CONFIG_ESP_VIDEO_ENABLE_USB_UVC_VIDEO_DEVICE=n
CONFIG_ESP_VIDEO_ENABLE_DVP_VIDEO_DEVICE=n

# esp-dsp's RISC-V hand-written assembly (dsps_dotprod_f32_arp4.S, reached from
# esp-sr's prebuilt c_speech_features through esp_speech_features.c) faults on
# this target: "Illegal instruction ... Instruction address misaligned" at the
# esp.lp.setup hardware-loop instruction, which aborts the whole panel on the
# first audio frame. The library is prebuilt against the optimized symbol, so
# CONFIG_DSP_ANSI cannot be used (it links out dsps_dotprod_f32_arp4 entirely);
# the fix is a generic one in firmware/components/esp_dsp_ansi_shim, which
# provides that symbol from the C implementation ahead of esp-dsp's own archive.
